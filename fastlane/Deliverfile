app_identifier "se.mews.wallconnectorlog"

# The screenshots are taken in demo mode, so they are committed like any asset.
screenshots_path "./screenshots/appstore"
overwrite_screenshots true

# Binaries go through the beta lane or Xcode, never through deliver.
skip_binary_upload true

# Nothing is submitted for review from here. That stays a decision you make
# in App Store Connect, with the finished page in front of you.
submit_for_review false
automatic_release false
precheck_include_in_app_purchases false
